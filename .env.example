# Default: mock data, no Power BI credentials needed.
DATA_SOURCE=mock
PORT=4000

# Live mode: switch DATA_SOURCE=powerbi and provide these server-only values.
# All IDs are Microsoft Entra / Power BI GUIDs.
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_DATASET_ID=

# Table with a Date column and numeric AFC, SFC, Loads, Cases columns.
POWERBI_TABLE=KpiDaily
POWERBI_TIMEOUT_MS=25000
