# Local default: no Entra credentials or Power BI data required
PORT=4000
HOST=127.0.0.1
DATA_SOURCE=mock
# Optional: exact approved frontend origin for cross-origin requests. Never use '*'.
CORS_ORIGIN=

# LIVE MODE - fill only with organization-approved values
# DATA_SOURCE=powerbi
# POWERBI_AUTH_METHOD=client_secret
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# POWERBI_WORKSPACE_ID=
# POWERBI_DATASET_ID=
# POWERBI_KPI_QUERY_FILE=queries/approved-kpis.dax
# POWERBI_RECORDS_QUERY_FILE=queries/approved-records.dax
